@import url("menu.css");

* {
    font-family: Inter, FontAwesome, sans-serif;
    font-weight: 600;
    margin: 2px;
    border-radius: 10px;
    background: transparent
}

#window {
  font-size: 15px;
}

window#waybar {
    background-color: rgba(43, 48, 59, 0.5);
    background: rgba(43, 48, 59, 0.2);
    border-radius: 0px;
    color: #ffffff;
    transition-property: background-color;
    transition-duration: .5s;
}

window#waybar.hidden {
    opacity: 0.2;
}

window#waybar.termite {
    background-color: #3F3F3F;
}

window#waybar.chromium {
    background-color: #000000;
    border: none;
}

button {
    box-shadow: inset 0 -3px transparent;
    border: none;
    border-radius: 0;
}

button:hover {
    background: inherit;
    box-shadow: none;
}

#workspaces button {
    padding: 0 5px;
    background-color: transparent;
    color: rgba(255, 255, 255, 0.9);
    border: none;
    border-radius: 16px;
    transition: all 0.3s ease;
}

#workspaces button:hover {
    background: rgba(0, 0, 0, 0.2);
    box-shadow: none;
}

#workspaces button.active {
    background: rgba(0, 0, 0, 0.2);
    background-color: #3584e4;
    color: #ffffff;
    box-shadow: none;
    font-weight: bold;
}

#workspaces button.focused {
    background: rgba(0, 0, 0, 0.2);
    background-color: #3584e4;
    color: #ffffff;
    box-shadow: none;
    font-weight: bold;
}

#workspaces button.urgent {
    background-color: #eb4d4b;
}

#mode {
    background-color: transparent;
    box-shadow: none;
}

#clock,
#battery,
#cpu,
#memory,
#disk,
#temperature,
#backlight,
#network,
#pulseaudio,
#wireplumber,
#custom-media,
#tray,
#mode,
#idle_inhibitor,
#scratchpad,
#power-profiles-daemon,
#mpd {
    padding: 0 10px;
    color: #ffffff;
    background-color: transparent;
}

#window,
#workspaces {
    margin: 0 4px;
}

.modules-left > widget:first-child > #workspaces {
    margin-left: 0;
}

.modules-right > widget:last-child > #workspaces {
    margin-right: 0;
}

#clock {
    color: #ffffff;
    font-size: 16px;
    padding: 0px 8px;
}

#clock:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

#battery {
    color: #ffffff;
}

#battery.charging, #battery.plugged {
    color: #4cd97b;
}

@keyframes blink {
    to {
        color: #f53c3c;
    }
}

#battery.critical:not(.charging) {
    color: #f53c3c;
    animation-name: blink;
    animation-duration: 0.5s;
    animation-timing-function: steps(12);
    animation-iteration-count: infinite;
    animation-direction: alternate;
}

#power-profiles-daemon {
    padding-right: 15px;
}

#power-profiles-daemon.performance {
    color: #f53c3c;
}

#power-profiles-daemon.balanced {
    color: #ffffff;
}

#power-profiles-daemon.power-saver {
    color: #4cd97b;
}

label:focus {
    background-color: transparent;
}

#cpu {
    color: #ffffff;
}

#memory {
    color: #ffffff;
}

#disk {
    color: #ffffff;
}

#backlight {
    color: #ffffff;
}

#network {
    color: #ffffff;
}

#network.disconnected {
    color: #f53c3c;
}

#pulseaudio {
    color: #ffffff;
    font-size: 16px;
}

#pulseaudio:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

#pulseaudio.muted {
    color: rgba(255, 255, 255, 0.4);
}

#wireplumber {
    color: #ffffff;
}

#wireplumber.muted {
    color: #f53c3c;
}

#custom-media {
    color: #ffffff;
    min-width: 100px;
    font-weight: bold;
}

#temperature {
    color: #ffffff;
}

#temperature.critical {
    color: #f53c3c;
}

#tray {
    background-color: transparent;
}

#tray:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

#tray > .passive {
    -gtk-icon-effect: dim;
}

#tray > .needs-attention {
    -gtk-icon-effect: highlight;
    color: #f53c3c;
}

#idle_inhibitor {
    color: rgba(255, 255, 255, 0.5);
}

#idle_inhibitor.activated {
    color: #ffffff;
}

#mpris {
    font-size: 15px;
    color: #ffffff;
    padding: 1px 8px 0px 8px;
}

#mpris:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

#mpd {
    color: #ffffff;
}

#mpd.disconnected {
    color: #f53c3c;
}

#mpd.stopped {
    color: rgba(255, 255, 255, 0.4);
}

#mpd.paused {
    color: rgba(255, 255, 255, 0.6);
}

#language {
    color: #ffffff;
    padding: 2.5px 8px;
    font-size: 16px;
}

#language:hover {
    background-color: rgba(255, 255, 255, 0.1);
}


#language.en {
    color: rgba(255, 255, 255, 0.7);
}

#language.ru {
    color: rgba(255, 255, 255, 0.7);
}

#keyboard-state {
    color: #ffffff;
    padding: 0 12px;
    margin: 0 5px;
    min-width: 16px;
    font-weight: 600;
}

#keyboard-state > label {
    padding: 0 5px;
}

#keyboard-state > label.locked {
    background: rgba(255, 255, 255, 0.1);
}

#scratchpad {
    background: transparent;
}

#scratchpad.empty {
    background-color: transparent;
}

#privacy {
    padding: 0;
}

#privacy-item {
    padding: 0 5px;
    color: white;
}

#privacy-item.screenshare {
    color: #cf5700;
}

#privacy-item.audio-in {
    color: #4cd97b;
}

#privacy-item.audio-out {
    color: #ffffff;
}

#custom-theme-switcher {
    color: #ffffff;
    padding: 8px;
}

#custom-swaync {
  padding: 0 8px;
  font-size: 14px;
  color: #ffffff;
}

#custom-swaync:hover {
  background-color: rgba(255, 255, 255, 0.1);
}

#custom-swaync.swaync-active {
  color: black;
}

#custom-swaync.swaync-empty {
  color: #ffffff;
}

/* Подсказки: те же цвета стекла, что у меню (menu.css) */
tooltip {
    background-color: @menu_bg;
    border: 1px solid @menu_border;
    border-radius: 12px;
    box-shadow: inset 0 1px 0 @menu_highlight;
    padding: 4px 6px;
    margin: 0;
}

tooltip label {
    color: @menu_fg;
    font-size: 12px;
    font-weight: 500;
    text-shadow: none;
    margin: 0;
}

/* Меню трея: цвета из menu.css (светлая/тёмная тема) */
window.popup,
window.popup decoration {
    background: transparent;
    box-shadow: none;
    border: none;
}

menu {
    background-color: @menu_bg;
    border: 1px solid @menu_border;
    border-radius: 14px;
    box-shadow: inset 0 1px 0 @menu_highlight;
    padding: 6px;
    margin: 0;
    color: @menu_fg;
}

menu menuitem {
    padding: 7px 14px;
    margin: 1px 0;
    border-radius: 9px;
    font-size: 13px;
    font-weight: 500;
    color: @menu_fg;
    text-shadow: none;
    transition: background 0.15s ease;
}

menu menuitem label {
    color: @menu_fg;
}

menu menuitem:hover {
    background-color: @menu_hover;
}

menu menuitem:disabled,
menu menuitem:disabled label {
    color: @menu_fg_dim;
}

menu menuitem check,
menu menuitem radio,
menu menuitem arrow {
    color: @menu_fg;
    margin: 0 6px 0 0;
}

menu separator {
    background-color: @menu_separator;
    min-height: 1px;
    margin: 4px 8px;
    border-radius: 0;
}
