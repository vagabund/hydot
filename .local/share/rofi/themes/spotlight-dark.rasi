/* Тёмное матовое стекло. Переключается switch_theme.sh */
* {
    bg:         rgba(30, 30, 32, 0.60);
    chip:       rgba(255, 255, 255, 0.08);
    border:     rgba(255, 255, 255, 0.12);
    fg:         rgba(255, 255, 255, 0.95);
    fg-dim:     rgba(255, 255, 255, 0.45);
    accent:     #78aeed;
    sel:        rgba(53, 132, 228, 0.75);
    sel-fg:     #ffffff;
}

@import "~/.local/share/rofi/themes/glass-base.rasi"
