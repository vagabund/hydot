/* Светлое матовое стекло. Переключается switch_theme.sh */
* {
    bg:         rgba(255, 255, 255, 0.55);
    chip:       rgba(255, 255, 255, 0.55);
    border:     rgba(255, 255, 255, 0.65);
    fg:         #1c1c1e;
    fg-dim:     rgba(28, 28, 30, 0.45);
    accent:     #3584e4;
    sel:        rgba(53, 132, 228, 0.85);
    sel-fg:     #ffffff;
}

@import "~/.local/share/rofi/themes/glass-base.rasi"
